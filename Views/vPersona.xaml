<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:xleguisamoS5.Models"
             x:Class="xleguisamoS5.Views.vPersona"
             Title="vPersona">
    <VerticalStackLayout Padding="15" Spacing="15">
        <Label Text="Semana 5: SQLITE"
               FontSize="20"
               FontAttributes="Bold"
               VerticalOptions="Center"
               HorizontalOptions="Center" />
        <Entry x:Name="txtNombre"
               Placeholder="Ingresar el nombre" />

        <Grid Padding="5" RowSpacing="5" ColumnSpacing="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Button x:Name="btnAgregar"
                    Text="Agregar persona"
                    Clicked="btnAgregar_Clicked"
                    Grid.Row="0" Grid.Column="0" />
            <Label x:Name="lblMenssage"
                   TextColor="Red"
                   Grid.Row="1" Grid.Column="0" />
            <Button x:Name="btnMostrar"
                    Text="Mostrar personas"
                    Clicked="btnMostrar_Clicked"
                    Grid.Row="2" Grid.Column="0" />
            <CollectionView x:Name="listaPersonas"
                            Grid.Row="3" Grid.Column="0">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Persona">
                        <Grid Padding="5" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Label Text="{Binding Id}"
                                   Grid.Column="0"
                                   VerticalOptions="Center" />
                            <Label Text="{Binding Name}"
                                   Grid.Column="1"
                                   VerticalOptions="Center" />
                            <Button Text="Editar"
                                   Grid.Column="2"
                                   CommandParameter="{Binding .}"
                                   Clicked="btnEditar_Clicked" />
                            <Button Text="Eliminar"
                                    Grid.Column="3"
                                    BackgroundColor="Red"
                                    TextColor="White"
                                    CommandParameter="{Binding Id}"
                                    Clicked="btnEliminar_Clicked" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </VerticalStackLayout>
</ContentPage>
